# Distillery settings
# Copy this file to `.env` and change what you need. Everything has a sensible
# default, so for most people the only thing to fill in is a judge API key.
# Restart Distillery after editing.

# ---- Judge API keys --------------------------------------------------------
# Only fill in the provider you use for the judge. Keys stay in this file:
# Distillery never writes them anywhere else.
# Using a local judge like "ollama/llama3.1:8b"? You don't need any key.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# ---- Ollama ----------------------------------------------------------------
# Where Ollama is running. Only change this if it's not on this computer.
DISTILLERY_OLLAMA_BASE_URL=http://localhost:11434

# ---- Where datasets are saved ----------------------------------------------
# A folder path, relative to where you start Distillery.
DISTILLERY_DATASETS_DIR=datasets

# ---- The web server --------------------------------------------------------
# 127.0.0.1 means only this computer can open the app. Keep it that way
# unless you really need to reach it from another machine.
DISTILLERY_HOST=127.0.0.1
DISTILLERY_PORT=8000

# ---- Advanced (optional) ---------------------------------------------------
# Longest answer, in tokens, the teacher and judge may write.
# DISTILLERY_DEFAULT_MAX_TOKENS=2048

# Other websites allowed to call the API from a browser, as a JSON list.
# Leave unset unless you're building your own front end.
# DISTILLERY_CORS_ORIGINS='["http://localhost:3000"]'
