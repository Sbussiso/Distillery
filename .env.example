# Distillery configuration. Copy to `.env` and edit.
# Ollama backend:
DISTILLERY_OLLAMA_BASE_URL=http://localhost:11434
# Where datasets are written (relative to project root):
DISTILLERY_DATASETS_DIR=datasets
# Server bind:
DISTILLERY_HOST=127.0.0.1
DISTILLERY_PORT=8000

# ---- Judge API keys (LiteLLM reads these) ----
# Only set the ones you use. The judge can also be a local Ollama model
# (e.g. "ollama/llama3.1:8b") which needs no key.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=